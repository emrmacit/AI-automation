# Copy this file to .env.local. Never commit .env.local.

# Google Sheets persistence. Share the target sheet with the service-account email.
GOOGLE_SHEETS_ID=replace-with-sheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=relay-sheets@example-project.iam.gserviceaccount.com
# Keep literal \n characters when setting this in Vercel.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
