# WhatsApp / Green API Konfigürasyonu (Opsiyonel Canlı Hat Bağlantısı İçin)
GREEN_API_URL=https://YOUR_INSTANCE.api.greenapi.com
GREEN_ID_INSTANCE=YOUR_ID_INSTANCE_HERE
GREEN_API_TOKEN=YOUR_API_TOKEN_HERE

# OpenAI API Konfigürasyonu (Opsiyonel Gelişmiş NLP İçin)
OPENAI_API_KEY=sk-proj-YOUR_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini
